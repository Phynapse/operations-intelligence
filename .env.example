# ---- Operations Intelligence: environment configuration ----
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ---- Application ----
# Environment name: local | staging | production
APP_ENV=local
LOG_LEVEL=INFO

# ---- API ----
# Comma separated list of allowed CORS origins.
# For local Vite development: http://localhost:5173
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Synthetic dataset ----
# Absolute or project-relative path to the CSV dataset directory.
DATA_DIR=data

# ---- LLM provider (OpenAI-compatible chat completions API) ----
# Any OpenAI-compatible endpoint: OpenAI, Azure OpenAI, Ollama, vLLM,
# LiteLLM gateway, Together, Groq, etc.
# Example: https://api.openai.com/v1
LLM_BASE_URL=https://api.openai.com/v1

# Server-side only. Never expose this value to the frontend.
LLM_API_KEY=

# Model identifier, e.g. gpt-4o-mini, llama-3.1-70b-instruct, qwen2.5-72b-instruct
LLM_MODEL=gpt-4o-mini

# Request timeout in seconds for LLM calls.
LLM_TIMEOUT=45

# ---- Analysis behaviour ----
# Hard cap on the number of rows any single deterministic analyzer will read.
MAX_ANALYSIS_ROWS=200000

# Minimum number of observations required before trend/anomaly statistics
# are considered reliable. Below this, findings are returned with caveats.
MIN_OBSERVATIONS_FOR_TREND=4

# Number of top contributors retained in evidence packages.
EVIDENCE_TOP_N=5

# Guard rail for incoming natural language questions.
MAX_QUESTION_LENGTH=600
